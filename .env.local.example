# 案件3 RAG — 環境変数の雛形
# このファイルをコピーして .env.local を作り、値を入れてください（.env.local はgit管理外）
#   cp .env.local.example .env.local

# --- Supabase（case3専用の新規プロジェクト・東京リージョン） ---
# ダッシュボード → Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role キーはサーバー専用（取り込みスクリプト・APIのみ）。公開厳禁
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- OpenAI（埋め込み text-embedding-3-small 用） ---
OPENAI_API_KEY=sk-...

# --- Anthropic（回答生成 Claude 用） ---
ANTHROPIC_API_KEY=sk-ant-...

# --- 認証で許可する社内メールドメイン ---
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=techbridge.co.jp
